# ---- Sign-in (REQUIRED before exposing beyond localhost) ----
# Visitors get a login page; sessions are a signed HttpOnly cookie. Use a long random password (12+ characters).
AUTH_USER=admin
AUTH_PASS=change-me-to-a-long-random-value
# Prefer a hash over a plaintext password:  printf '%s' 'your password' | node src/cli.js hash-password
# (then delete AUTH_PASS and set:)
# AUTH_PASS_HASH=scrypt$...
# Keep sessions valid across restarts (otherwise everyone signs in again after a restart), and how long they last:
# AUTH_SECRET=<long random string>
# AUTH_SESSION_HOURS=12
# Bearer token for Prometheus / scripts (optional; scripts can also use HTTP Basic with the same user/password)
# AUTH_TOKEN=

# ---- Technologies: either is optional ----
ENABLE_HAPROXY=true
ENABLE_NGINX=true

# ---- Connect servers from the UI ----
# Lets users add a HAProxy/NGINX (URL, username, password) in the browser via "Connect a server".
# Credentials are stored on the server in the data volume (file mode 0600) and never sent back to the browser.
# Anyone who can use the UI can then make GateLight connect to hosts of their choosing: keep AUTH_* set, and
# optionally restrict targets with UI_ALLOWED_HOSTS=lb1.example.com,*.internal.example.com
ALLOW_UI_INSTANCES=true
# UI_ALLOWED_HOSTS=
# Connections added in the UI are private to the browser that added them (a random cookie; only its hash is stored).
# Set true for a shared team deployment where every visitor should see every saved connection.
# UI_INSTANCES_SHARED=false
# Saved connections nobody has opened for this many days are removed (credentials included).
# UI_INSTANCE_TTL_DAYS=7

# ---- Instances ----
# Preferred: config/instances.json (see examples/instances.example.json).
# Quick single-instance alternative via env:
# HAPROXY_STATS_URL=http://10.0.0.5:8404/stats
# HAPROXY_STATS_USER=viewer
# HAPROXY_STATS_PASS=...
# NGINX_STATUS_URL=http://10.0.0.6/nginx_status
# NGINX_CONFIG_PATH=/app/config/nginx/nginx.conf

# ---- Alerting (Slack / Mattermost / Teams-compatible incoming webhook, or any JSON receiver) ----
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
# ALERT_MIN_FAILURES=2

# POLL_INTERVAL=5000
# HISTORY_POINTS=360
# Chart history is saved to SQLite in DATA_DIR (history.db) so it survives restarts. Needs Node 22.5+ (the Docker image has it).
# HISTORY_DB=off          # keep history in memory only
# HISTORY_RAW_HOURS=6     # full-resolution samples, then rolled up to 1-minute averages
# HISTORY_KEEP_DAYS=14    # how long the rolled-up history is kept
# DEMO_MODE=false
